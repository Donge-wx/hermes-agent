ARG BASE_IMAGE=nousresearch/hermes-agent:v2026.8.19@sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09
FROM ${BASE_IMAGE}

ARG HERMES_GIT_SHA
ARG MYKING_SOURCE_BASE_REVISION
ARG MYKING_SOURCE_STAMP
RUN test -n "${HERMES_GIT_SHA}" && \
    test -n "${MYKING_SOURCE_BASE_REVISION}" && \
    test -n "${MYKING_SOURCE_STAMP}"
LABEL org.opencontainers.image.base.name="nousresearch/hermes-agent:v2026.8.19@sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09" \
      org.opencontainers.image.base.revision="${HERMES_GIT_SHA}" \
      org.opencontainers.image.revision="${MYKING_SOURCE_STAMP}" \
      com.myking.source.base-revision="${MYKING_SOURCE_BASE_REVISION}" \
      com.myking.source.stamp="${MYKING_SOURCE_STAMP}"

USER root
WORKDIR /opt/hermes
COPY --chown=root:root hermes_cli/web_server.py hermes_cli/http_session_upload.py hermes_cli/managed_upload_guard.py hermes_cli/managed_update_policy.py /opt/hermes/hermes_cli/
COPY --chown=root:root hermes_state.py hermes_state_common.py hermes_state_portability.py hermes_state_schema.py hermes_state_search.py /opt/hermes/
COPY --chown=root:root tui_gateway/server.py tui_gateway/ws.py tui_gateway/methods_prompt.py /opt/hermes/tui_gateway/
COPY --chown=root:root tui_gateway/methods_browser_control.py /opt/hermes/tui_gateway/
COPY --chown=root:root agent/compaction_display.py /opt/hermes/agent/
COPY --chown=root:root gateway/browser_control_broker.py /opt/hermes/gateway/
